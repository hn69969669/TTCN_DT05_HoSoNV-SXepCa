@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #3F5264
skinparam defaultTextAlignment center
skinparam roundCorner 0
skinparam monochrome false
skinparam usecaseBackgroundColor #EFF5F8
skinparam usecaseBorderColor #385B70
skinparam rectangleBorderColor #385B70
skinparam componentStyle rectangle
skinparam classAttributeIconSize 0
hide footbox
actor "Quản lý" as QL
boundary "Form phân công" as UI
control "Dịch vụ xếp ca" as S
database "SQL Server" as DB
QL -> UI : Chọn nhân viên và ca
UI -> S : assign_employee(người thao tác, ca, nhân viên)
group transaction.atomic()
S -> DB : Khóa ScheduleGate(id=1); đọc lại quyền, ca, hồ sơ và lịch
S -> S : Kiểm quyền, trạng thái nháp, sức chứa\nvà evaluate_assignment trên lịch dự kiến
alt Đủ điều kiện
  S -> DB : Tạo Assignment; commit
  S --> UI : Số người đã xếp / số cần
else Bị chặn hoặc thiếu dữ liệu
  S --> UI : Trả lý do; giữ nguyên phân công
end
end
UI --> QL : Hiển thị kết quả trong phạm vi được xem
@enduml
