@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #3F5264
skinparam defaultTextAlignment center
skinparam roundCorner 0
skinparam usecaseBackgroundColor #EFF5F8
skinparam usecaseBorderColor #385B70
skinparam rectangleBorderColor #385B70
skinparam componentStyle rectangle
skinparam classAttributeIconSize 0
skinparam activityBackgroundColor #EFF5F8
skinparam activityBorderColor #385B70
skinparam stateBackgroundColor #EFF5F8
skinparam stateBorderColor #385B70
left to right direction
actor "Quản lý chi nhánh" as QL
rectangle "Hồ sơ nhân viên và xếp ca — DT05" {
  usecase "Cập nhật hồ sơ nhân viên" as PROFILE
  usecase "Ghi nhận giấy tờ và\nđào tạo đã xác minh" as EV
  usecase "Xem lịch chi nhánh" as VIEW
  usecase "Tạo ca làm việc" as CREATE
  usecase "Sửa ca nháp" as EDIT
  usecase "Bỏ phân công nhân viên" as REMOVE
  usecase "Phân công nhân viên" as ASSIGN
  usecase "Công bố ca làm việc" as PUB
  usecase "Kiểm tra điều kiện\nphân công" as CHECK
}
QL -- PROFILE
QL -- EV
QL -- VIEW
QL -- CREATE
QL -- EDIT
QL -- REMOVE
QL -- ASSIGN
QL -- PUB
ASSIGN ..> CHECK : <<include>>
PUB ..> CHECK : <<include>>
note bottom of EDIT
  Nếu ca đã có người, phải kiểm lại
  các phân công trước khi lưu sửa đổi.
end note
@enduml
