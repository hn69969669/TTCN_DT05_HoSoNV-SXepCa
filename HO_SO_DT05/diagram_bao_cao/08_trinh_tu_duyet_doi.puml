@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #3F5264
skinparam defaultTextAlignment center
skinparam roundCorner 0
skinparam monochrome false
skinparam usecaseBackgroundColor #EFF5F8
skinparam usecaseBorderColor #385B70
skinparam rectangleBorderColor #385B70
skinparam componentStyle rectangle
skinparam classAttributeIconSize 0
hide footbox
actor "Quản lý" as QL
boundary "Form duyệt đơn" as UI
control "Dịch vụ đổi ca" as S
database "SQL Server" as DB
QL -> UI : Duyệt đề nghị đổi ca
UI -> S : decide_swap(người duyệt, đơn, quyết định)
group transaction.atomic()
S -> DB : Khóa ScheduleGate(id=1); đọc lại quyền, đơn và hai phân công
alt Sai quyền
 S --> UI : Từ chối truy cập
else Đơn đã xử lý
 S --> UI : Trả kết quả đang lưu
else Đơn đang chờ
 S -> S : So chủ gốc, kiểm hai ca tương lai;\ndựng và đánh giá lịch mới của cả hai người
 alt Không đạt
  S --> UI : Trả lý do; giữ PENDING và hai lịch cũ
 else Đạt
  S -> DB : Đổi hai Assignment và ghi APPROVED, người, thời điểm
  alt Tất cả bản ghi thành công
   S -> DB : Commit
   S --> UI : Trả kết quả đã duyệt
  else Lỗi trong lúc ghi
   S -> DB : Rollback toàn bộ
   S --> UI : Báo lỗi; giữ đơn và lịch trước giao dịch
  end
 end
end
end
UI --> QL : Hiển thị kết quả
@enduml
