@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #3F5264
skinparam defaultTextAlignment center
skinparam roundCorner 0
skinparam monochrome false
skinparam usecaseBackgroundColor #EFF5F8
skinparam usecaseBorderColor #385B70
skinparam rectangleBorderColor #385B70
skinparam componentStyle rectangle
skinparam classAttributeIconSize 0
hide circle
hide methods
entity Branch
entity Position
entity Employee
entity "User (Django)" as U
entity Shift {
  * id : PK
  code : UK
  branch_id / position_id : FK
  published_by_id : FK, NULL
  required_count / status
}
entity Assignment {
  * id : PK
  public_code : UK
  shift_id / employee_id : FK
}
entity SwapRequest {
  * id : PK
  assignment_a_id / assignment_b_id : FK
  original_a_employee_id / original_b_employee_id : FK
  created_by_id / decided_by_id : FK
  status / reason
}
entity SundayBaseline {
  * id : PK
  employee_id : FK
  sunday_date / worked_elsewhere
}
entity ScheduleGate {
  * id : PK, CHECK (id = 1)
}
Branch ||--o{ Shift
Position ||--o{ Shift
U |o--o{ Shift : công bố
Shift ||--o{ Assignment
Employee ||--o{ Assignment
Employee ||--o{ SundayBaseline
Assignment ||--o{ SwapRequest : phân công A
Assignment ||--o{ SwapRequest : phân công B
Employee ||--o{ SwapRequest : chủ gốc A
Employee ||--o{ SwapRequest : chủ gốc B
U ||--o{ SwapRequest : tạo đơn
U |o--o{ SwapRequest : quyết định
@enduml
