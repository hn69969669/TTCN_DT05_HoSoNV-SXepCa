@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #3F5264
skinparam defaultTextAlignment center
skinparam roundCorner 0
skinparam monochrome false
skinparam usecaseBackgroundColor #EFF5F8
skinparam usecaseBorderColor #385B70
skinparam rectangleBorderColor #385B70
skinparam componentStyle rectangle
skinparam classAttributeIconSize 0
hide circle
hide methods
entity "User\n(tài khoản Django)" as U {
  * id : PK
}
entity Branch {
  * id : PK
  code : UK
}
entity ManagerBranch {
  * id : PK
  user_id : FK
  branch_id : FK
}
entity Employee {
  * id : PK
  code : UK
  home_branch_id : FK
  user_id : FK, NULL
}
entity EmployeeBranch {
  * id : PK
  employee_id : FK
  branch_id : FK
}
entity Evidence {
  * id : PK
  employee_id : FK
  evidence_type_id : FK
  verified_by_id : FK
  valid_from / valid_until
}
entity EvidenceType {
  * id : PK
  code : UK
  category
}
entity PositionRequirement {
  * id : PK
  position_id : FK
  evidence_type_id : FK
}
entity Position {
  * id : PK
  code : UK
}
U ||--o{ ManagerBranch
Branch ||--o{ ManagerBranch
U |o--o| Employee : tài khoản
Branch ||--o{ Employee : chủ quản
Employee ||--o{ EmployeeBranch
Branch ||--o{ EmployeeBranch
Employee ||--o{ Evidence
U ||--o{ Evidence : xác minh
EvidenceType ||--o{ Evidence
EvidenceType ||--o{ PositionRequirement
Position ||--o{ PositionRequirement
@enduml
